encoding  utf-8
# =====================================================================
#  Swildons Hole -- Entrance Series plan, 1:200
# =====================================================================
#
#  The second half of the CI build (see thconfig). It is a separate
#  file only because it is a second plan sheet at a different scale,
#  and Therion takes one selected map per projection per run. CI runs
#  it with its own log (-l output/therion-entrance.log) so therion.log
#  stays the log of the main build.
# ---------------------------------------------------------------------

input gb_layout.thc

source swildonsmaster.th

select EntranceSeriesPlan@SwildonsHole

layout entrance-sheet
  copy GB_Std

  scale 1 200
  base-scale 1 180

  symbol-hide line survey

  color map-fg altitude
  copy LayoutColourSymbols
endlayout

export map -projection plan -layout entrance-sheet -o output/Swildons-entrance-plan.pdf
export map -projection plan -layout entrance-sheet -fmt svg -o output/Swildons-entrance-plan.svg
