encoding  utf-8
# =====================================================================
#  Swildons Hole -- Entrance Series plan and extended elevation, 1:200
# =====================================================================
#
#  The second half of the CI build (see thconfig). It is a separate
#  file only because it is a second plan sheet at a different scale,
#  and Therion takes one selected map per projection per run. CI runs
#  it with its own log (-l output/therion-entrance.log) so therion.log
#  stays the log of the main build.
# ---------------------------------------------------------------------

input gb_layout.thc

source swildonsmaster.th

select EntranceSeriesPlanSections@SwildonsHole
select EntranceSeriesExtended@SwildonsHole

layout entrance-sheet
  copy GB_Std

  scale 1 200
  base-scale 1 180

  symbol-hide line survey

  color map-fg altitude
  copy LayoutColourSymbols
endlayout

# The extended elevation is traced from Footleg's PocketTopo side views.
# Where Therion's layout breaks a loop differently from a sketch, the
# sketch is split, so passages can show gaps or overlaps at loop breaks.
layout entrance-extended
  copy entrance-sheet
  map-header 0 0 nw
  legend-columns 5
  legend-width 30 cm
endlayout

export map -projection plan -layout entrance-sheet -o output/Swildons-entrance-plan.pdf
export map -projection extended -layout entrance-extended -o output/Swildons-entrance-extended-elevation.pdf
export map -projection plan -layout entrance-sheet -fmt svg -o output/Swildons-entrance-plan.svg
