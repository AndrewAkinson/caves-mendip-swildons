encoding  utf-8
input ../gb_layout.thc

source Swildons.th

select EntranceSeriesPlan@SwildonsHole

export map -projection plan -layout local -o Swildons_Ent-plan.pdf
export map -projection [elevation 000] -layout local -o Swildons_Ent-elevEW.pdf
export model -o swildons.lox
export model -format vrml -o swildons.vrml

layout local
    copy GB_Std

    scale 1 200
    base-scale 1 180

    symbol-hide line survey
    
    #color by altitude (comment out this for b&w PDFs or for single colour filled passages)
    color map-fg altitude
	
    #Single passage fill color (comment out this for b&w PDFs or for colour by altitude)
    #color map-fg [50 50 50] # mid-grey
	
    #Map background fill color (comment these out for white background, or include one for background colour)
    #color map-bg [97 86 38] # yellow brown
    #color map-bg [75 75 75] # light-grey

    #Comment out this for b&w PDFs. Include it for colour PDFs.
    copy LayoutColourSymbols
	
    #debug on
endlayout
