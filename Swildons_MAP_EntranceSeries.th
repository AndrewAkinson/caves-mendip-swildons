#Swildons Hole, Priddy, Mendip, Somerset, UK
#Resurvey Project. Lead by Paul 'Footleg' Fretwell, Jun. 2013 - Mar. 2016
#Plan Maps for Entrance Series

# (input statements for drawings are in the corresponding centreline data .th files)

join swil1LongDryWaySP1@Swildons ShortDryWaySP1@ShortDryWay.Swildons
join KenneysSP1@KenneysDigToShowerbath.Swildons swil1LongDryWaySP1@Swildons
join ShortDryWaySP3@ShortDryWay.Swildons swil1ShortDryWaySP2@Swildons

map EntranceSeriesPlan -title "Swildons Hole - Entrance Series"
  swil1LongDryWaySP4@Swildons
    break
  swil1EntranceSP1@Swildons
  swil1EntranceSP2@Swildons
  swil1LongDryWaySP3@Swildons
  swil1LongDryWaySP1@Swildons
  swil1LongDryWaySP2@Swildons
  KenneysSP2@KenneysDigToShowerbath.Swildons
  KenneysSP1@KenneysDigToShowerbath.Swildons
  swil1DryWayStreamSP1@Swildons
    break
  swil1DryWayStreamSP2@Swildons
  swil1LongDryWaySP5@Swildons
  swil1BoulderChamberSP1@Swildons
  swil1BoulderChamberSP2@Swildons
  ShortDryWaySP1@ShortDryWay.Swildons
  ShortDryWaySP2@ShortDryWay.Swildons
  ShortDryWaySP3@ShortDryWay.Swildons
  swil1OldGrottoSP1@Swildons
  swil1ShortDryWaySP2@Swildons
    break
  swil1OldGrottoStreamSP1@Swildons
endmap

