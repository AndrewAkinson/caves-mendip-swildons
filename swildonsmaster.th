encoding  utf-8
#Swildons Hole, Priddy, Mendip, Somerset, UK
#Master Survey Project. Lead by Paul 'Footleg' Fretwell, Jun. 2013 - Jan. 2019

survey SwildonsHole
  #import cave centreline
  input Swildons_Centreline.th

  #import maps for plan drawings
  input Swildons_MAP_EntranceSeries.th
  input Swildons_MAP_Streamway1.th

  #import maps for elevation drawings
  input Swildons_MAP-elev_EntranceSeries.th
  
  #Master Map
  map MasterPlan -title "Swildons Hole"
    EntranceSeriesPlan
    Streamway1Plan
  endmap
endsurvey

