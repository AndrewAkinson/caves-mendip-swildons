encoding  utf-8
#Swildons Hole, Priddy, Mendip, Somerset, UK
#Master Survey Project. Lead by Paul 'Footleg' Fretwell, Jun. 2013 - Jan. 2019

survey SwildonsHole
  #import cave centreline
  input Swildons_Centreline.th

  #import maps for plan drawings
  input Swildons_MAP_EntranceSeries.th
  input Swildons_MAP_Streamway1.th

  #import maps for elevation drawings
  input Swildons_MAP-elev_EntranceSeries.th
  input Swildons_MAP-elev_Streamway.th
  input Swildons_MAP-ext_EntranceSeries.th
  
  #Master Map
  map MasterPlan -title "Swildons Hole"
    EntranceSeriesPlan
    Streamway1Plan
  endmap

  #W. I. Stanton's survey as centreline, for planning the resurvey beyond Sump 1
  map StantonCentreline -projection plan -title "W. I. Stanton's survey"
    wstanton@Swildons
  endmap

  map PlanWithStanton -title "Swildons Hole - resurvey and W. I. Stanton's survey"
    MasterPlan
    StantonCentreline
  endmap
endsurvey

