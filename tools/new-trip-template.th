encoding  utf-8
# A new resurvey trip. Copy to the top of the repository as
# Swildons_<Where>.th (e.g. Swildons_Sump1ToSwildons2.th) and fill in.
# SexyTopo's Therion export writes the centreline block for you: paste
# its data and extend lines in place of the example below, keeping the
# rest. See tools/README.md for the whole workflow.

survey Sump1ToSwildons2 -title "Sump 1 to Swildons Two"

  # The drawings, once converted (tools/sketch2therion):
  # input Swil1P_Sump1ToSwildons2.th2
  # input Swil1E_Sump1ToSwildons2.th2

  centreline
    copyright yyyy "Copyright Holder"

    date yyyy.mm.dd

    team "First Surveyor" notes
    team "Second Surveyor" instruments
    team "Third Surveyor" dog

    # SexyTopo writes: data normal from to tape compass clino ignoreall
    data normal from to tape compass clino

    # The first station is where the trip starts from an existing station;
    # tie it on in Swildons_Centreline.th, e.g.
    #   equate 0@Sump1ToSwildons2 24.33@TratmansToSump1
    0 1 4.21 231.5 -12.0
    1 - 1.10 140.0 3.0
    1 2 3.87 245.0 -4.5

    # Extended-elevation directions (SexyTopo writes these too)
    extend right

  endcentreline
endsurvey
